<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Kjører Dypdykk-importen hver natt kl. 03:17 på Mac.
     Installer: endre STI nedenfor, kopier til ~/Library/LaunchAgents/ og kjør
     launchctl load ~/Library/LaunchAgents/no.dypdykk.import.plist -->
<plist version="1.0"><dict>
  <key>Label</key><string>no.dypdykk.import</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>STI/dypdykk-data/automation/nattlig-import.sh</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>17</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/dypdykk-import.out</string>
  <key>StandardErrorPath</key><string>/tmp/dypdykk-import.err</string>
</dict></plist>
